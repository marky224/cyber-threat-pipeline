# cyber-threat-pipeline — environment variables (copy to .env; .env is gitignored)
# In CI these come from GitHub Actions secrets/vars (see .github/workflows/pipeline.yml).
# Local dev: `cp .env.example .env` and fill in the values.

# ---------------------------------------------------------------------------
# Neon Postgres (pooled connection — required for serverless + Evidence)
# ---------------------------------------------------------------------------
# Format: postgresql://<user>:<password>@<pooler-host>/<db>?sslmode=require
# The pipeline write path uses this read-write URL. Grafana Cloud uses a
# separate read-only URL configured directly in Grafana (not here).
NEON_DATABASE_URL=

# ---------------------------------------------------------------------------
# AlienVault OTX (https://otx.alienvault.com)
# ---------------------------------------------------------------------------
# 10k req/hr authenticated. Get from profile → "OTX Key".
OTX_API_KEY=

# ---------------------------------------------------------------------------
# LLM providers — analyst brief (Grok + Claude, side-by-side)
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
XAI_API_KEY=

# ---------------------------------------------------------------------------
# AWS deploy — Evidence.dev static site
# ---------------------------------------------------------------------------
# CI auth is OIDC via aws-actions/configure-aws-credentials@v4 — no static
# keys. Locally, prefer `AWS_PROFILE` + `~/.aws/config`. The variables below
# are required for any non-OIDC path (local deploys, ad-hoc invocations).
AWS_REGION=us-east-1
REPORT_BUCKET=
CLOUDFRONT_DISTRIBUTION_ID=

# Public hostname the Evidence site is served from. Used by Terraform + by
# Evidence's site base URL. Default per locked decision Q9.
DEPLOY_SUBDOMAIN=cyber-intel.markandrewmarquez.com

# ---------------------------------------------------------------------------
# Grafana Cloud — operator bootstrap (NOT used by the pipeline at runtime)
# ---------------------------------------------------------------------------
# These let local tooling (and Claude during bootstrap) provision the
# monitoring/ artifacts into the live Grafana stack via the HTTP API.
# After bootstrap, day-to-day pipeline runs do not need these.
#
# GRAFANA_STACK_URL: your stack base URL, e.g. https://<stack-slug>.grafana.net
# GRAFANA_SERVICE_ACCOUNT_TOKEN: token from a service account with Admin role
#   (Grafana → Administration → Users and access → Service accounts →
#    Add service account → Add token). The token is shown ONCE — paste it
#    here immediately. It looks like `glsa_xxxxxxxx...`.
GRAFANA_STACK_URL=
GRAFANA_SERVICE_ACCOUNT_TOKEN=
